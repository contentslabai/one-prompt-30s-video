{
  "name": "kinetic-30s-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "30초 · 60fps · 4K 타다닥 키네틱 타이포 영상 스타터 (Remotion + three.js)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "preview": "remotion render src/index.ts KineticViewer out/preview.mp4 --frames=0-299 --scale=0.5",
    "still": "remotion still src/index.ts KineticViewer out/still.png --frame=960 --scale=0.5",
    "render": "remotion render src/index.ts KineticViewer out/viewer-4k.mp4 --codec=h264 --crf=16",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "@remotion/cli": "4.0.491",
    "@remotion/three": "4.0.491",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.491",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/three": "0.180.0",
    "typescript": "5.9.3"
  }
}
